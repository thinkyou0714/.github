# local-rag-poc 設定例（cp .env.example .env して編集）
# 秘密情報は置かない。全項目省略可能（省略時は src/config.py の既定値）。

# --- Ollama ---
# ネイティブ実行時: http://localhost:11434 / docker compose 時: http://ollama:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_FALLBACK_MODEL=qwen3:4b
# デモや検証でモデルを強制したい場合のみ指定（例: qwen3:4b）
#OLLAMA_MODEL_FORCE=

# --- モデル ---
EMBED_MODEL_NAME=cl-nagoya/ruri-v3-310m
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3

# --- 検索パラメータ ---
TOP_K_EMBED=50
TOP_K_RERANK=5
RERANK_SCORE_THRESHOLD=0.30

# --- チャンク分割 ---
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# --- タイムアウト ---
OLLAMA_TIMEOUT_SEC=180
