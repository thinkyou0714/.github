# ビルドコンテキストから除外するもの。
# 最重要は data/ : 取り込み資料（機密回避が最重要要件の対象物）と ベクタDB を
# イメージ・ビルドコンテキストの経路に一切乗せない（仕様書 §2）。
# 実行時には docker-compose.yml のバインドマウントで共有される。
data/

# venv（数GB になり得る）と Python キャッシュ。コンテキスト転送の肥大化と、
# ホストの .pyc がイメージに焼き込まれるのを防ぐ
venv/
.venv/
__pycache__/
*.pyc

# 環境ごとの設定・秘密は env_file（compose）経由で渡す。イメージに焼かない
.env

# 生成物・履歴
eval/results/
.git/
